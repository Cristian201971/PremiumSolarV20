                        <div class="service__content">
                            <h4><a href="#0" class="text-white primary-hover">¡Ahorre dinero!</a></h4>
                            <p class="text-white pt-10 pb-10 text-justify">
                                <br>
                                Reduce significativamente las facturas eléctricas y obtén energías gratis a largo plazo.

                            </p>
                            @*   <a href="../ServicioDetalle" class="more-btn text-white mt-40">
                            Leer Más<i class="fa-solid fa-plus ml-10"></i>
                            </a> *@
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.15s">
