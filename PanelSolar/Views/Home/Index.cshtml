@{
    ViewData["Title"] = "Home";
}

<!-- Banner area start here -->
<section class="banner-area bg-image" data-background="assets/images/banner/experience-bg.png">
    <div class="banner__right">
        <img src="assets/images/banner/hero.jpg" alt="image">
    </div>
    <div class="container">
        <div class="banner__content">
            <h1 class="wow fadeInUp" data-wow-duration="1.15s" data-wow-delay="0.15s">
                Impulsando el futuro con <span class="primary-color">Energías Limpias</span>
            </h1>
            <p class="wow fadeInUp" data-wow-duration="1.30s" data-wow-delay="0.30s">
                Buscamos entregar
                la mayor calidad en
                soluciones de energías limpias.
            </p>


            <a href="../Cotizar" class="btn-two d-none d-lg-inline-block">
                Cotizar Instalación <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
            <div class="bars d-block d-lg-none">
                <i id="openButton" class="fa-solid fa-bars"></i>
            </div>


        </div>
    </div>

</section>
<!-- Banner area end here -->
<!-- Service area start here -->
<section class="service-area pb-120 secondary-bg bg-image" data-background="assets/images/bg/service-bg.png">
