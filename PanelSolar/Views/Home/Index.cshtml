                    </div>
                </div>

                <div class="col-lg-4 wow fadeInUp" data-wow-delay="0.15s">
                    <div class="service__item">
                        <div class="service__icon">
                            <img src="assets/images/icon/service1.svg" alt="icon">
                        </div>
                        <div class="service__content">
                            <h4><a href="#0" class="text-white primary-hover">
                                Incremento en<br/>valor de la propiedad
                             </a>
                             </h4>
